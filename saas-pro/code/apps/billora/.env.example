# Copy to .env.local. Everything here is optional in development.
DATABASE_URL=postgres://saas:saas@localhost:5432/saas_billora
# Public origin of this app; used in email links.
BETTER_AUTH_URL=http://localhost:3000
# Required in production: 32+ random characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Google sign-in appears only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
