{
  "name": "quickbite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @quickbite/web dev",
    "build": "pnpm --filter @quickbite/web build",
    "preview": "pnpm --filter @quickbite/web preview",
    "images": "node packages/seed/scripts/build-images.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "screenshots": "node scripts/screenshots.mjs",
    "emulators": "pnpm build:functions && METADATA_SERVER_DETECTION=none firebase emulators:start --project demo-quickbite",
    "seed:firebase": "METADATA_SERVER_DETECTION=none tsx packages/seed/scripts/load-firestore.ts",
    "test:rules": "METADATA_SERVER_DETECTION=none firebase emulators:exec --project demo-quickbite --only firestore 'vitest run --config tests/rules/vitest.config.ts'",
    "test:contract": "pnpm build:functions && METADATA_SERVER_DETECTION=none firebase emulators:exec --project demo-quickbite --only auth,firestore,functions 'pnpm seed:firebase && vitest run --config tests/contract/vitest.config.ts'",
    "dev:firebase": "pnpm build:functions && METADATA_SERVER_DETECTION=none firebase emulators:exec --project demo-quickbite --ui --only auth,firestore,functions 'node scripts/dev-firebase.mjs'",
    "test:e2e:firebase": "pnpm build:functions && METADATA_SERVER_DETECTION=none firebase emulators:exec --project demo-quickbite --only auth,firestore,functions 'node scripts/e2e-firebase.mjs'",
    "build:functions": "pnpm --filter @quickbite/functions build",
    "sim": "METADATA_SERVER_DETECTION=none tsx firebase/functions/src/sim.ts",
    "build:supabase": "pnpm --filter @quickbite/supabase build",
    "seed:supabase": "tsx supabase/scripts/seed.ts",
    "sim:supabase": "tsx supabase/scripts/sim.ts",
    "dev:supabase": "node scripts/dev-supabase.mjs",
    "test:supabase:standin": "node scripts/standin-postgres.mjs vitest run --config tests/supabase/vitest.config.ts",
    "test:supabase:db": "vitest run --config tests/supabase/vitest.config.ts",
    "test:contract:supabase": "CONTRACT_BACKENDS=supabase vitest run --config tests/contract/vitest.config.ts",
    "test:e2e:supabase": "node scripts/e2e-supabase.mjs",
    "payments:check": "tsx scripts/payments-live-check.ts",
    "test:hosting": "node scripts/hosting-check.mjs",
    "launch:check": "tsx scripts/launch-check.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.56.1",
    "@quickbite/core": "workspace:*",
    "@quickbite/seed": "workspace:*",
    "@quickbite/server": "workspace:*",
    "@quickbite/supabase": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.32.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postgres": "3.4.9",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
