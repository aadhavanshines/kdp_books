# Which backend the web app talks to: memory | firebase | supabase
#   memory   - seed data in the browser, no accounts or emulators needed (pnpm dev)
#   firebase - Firebase Auth + Firestore (pnpm dev:firebase runs it on local emulators)
#   supabase - Supabase Auth + Postgres + Edge Functions (pnpm dev:supabase runs a local stack)
VITE_BACKEND=memory

# Firebase web config. Leave these empty to use the local emulators with the
# "demo-quickbite" project, which needs no Firebase account.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
# true on Firebase Hosting: call functions at <site>/api/<name> so the CSP needs no functions host.
VITE_FIREBASE_FUNCTIONS_VIA_HOSTING=
# Set to a host (e.g. 127.0.0.1) to use the emulators with a non-demo project id.
VITE_FIREBASE_EMULATOR_HOST=

# Supabase web config. Leave these empty to use the local stack (supabase start),
# which needs no Supabase account. The anon key is public by design: RLS decides what it can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local only: Mailpit, where the local stack's sign-in emails land (default http://127.0.0.1:54324).
VITE_SUPABASE_MAILPIT_URL=

# Only changes the banner; the server decides how payments work (see README → Payments).
#   fake (default) "Demo mode" banner   test  "Test mode" banner   live  no banner
VITE_PAYMENTS_MODE=fake
# Seconds per order tracking step for the in-memory backend's simulator (default 45).
VITE_DEMO_STEP_SECONDS=
