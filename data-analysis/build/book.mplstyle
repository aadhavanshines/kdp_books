# Print-friendly chart style for the book's figures (6 x 9 in paperback).
# Readers' charts use matplotlib's defaults; the data and code are the same.
figure.dpi: 100
savefig.dpi: 300
figure.figsize: 6.4, 3.6
font.family: Liberation Sans
font.size: 9
axes.titlesize: 10
axes.titleweight: bold
axes.labelsize: 9
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.alpha: 0.3
axes.prop_cycle: cycler('color', ['1f3a5f', 'c25400', '6e8096', '2e7d32', '8d6e63'])
legend.frameon: False
lines.linewidth: 1.8
