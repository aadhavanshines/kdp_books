{
  "name": "reelhouse-tv",
  "version": "1.0.0",
  "private": true,
  "description": "Reelhouse TV: a streaming app for Android TV (react-native-tvos), with a web build for checking focus in a browser.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "EXPO_TV=1 expo run:android",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --platform android --clean",
    "gen:art": "node scripts/gen-art.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.22",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "globals": "^14.0.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "expo": {
    "install": {
      "exclude": ["react-native"]
    }
  }
}
