{
  "expo": {
    "name": "Platter",
    "slug": "platter",
    "scheme": "platter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "app.platter.example", "supportsTablet": false },
    "android": { "package": "app.platter.example", "edgeToEdgeEnabled": true },
    "web": { "output": "single", "bundler": "metro", "name": "Platter", "shortName": "Platter", "themeColor": "#FC5A1E" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#FC5A1E" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
