{
  "expo": {
    "name": "Cartly",
    "slug": "cartly",
    "scheme": "cartly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "app.cartly.example", "supportsTablet": false },
    "android": { "package": "app.cartly.example", "edgeToEdgeEnabled": true },
    "web": { "output": "single", "bundler": "metro", "name": "Cartly", "shortName": "Cartly", "themeColor": "#2453FF" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#2453FF" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
